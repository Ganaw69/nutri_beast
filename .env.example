# Copy this file to .env.production and replace the example HTTPS origins.
# Uploaded media must be served from the same HTTPS CDN/API origin configured
# here; never leave this set to a localhost or HTTP address in production.
VITE_FORCE_LIVE_API=true
VITE_API_BASE_URL=https://api.example.com/api
VITE_MEDIA_BASE_URL=https://media.example.com
VITE_NUTRITION_API_BASE_URL=https://nutrition.example.com/
