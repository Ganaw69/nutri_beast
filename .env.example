# Copy this file to .env.production (or configure these values in your host)
# before running the production build. Never put private API keys in VITE_* vars:
# Vite embeds them into the browser bundle.

# Main catalogue, pricing, and media API.
VITE_API_BASE_URL=https://api.example.com/api
VITE_MEDIA_BASE_URL=https://api.example.com

# AI services. Each value is the public HTTPS origin only; the app appends
# /health and /v1/chat.
VITE_NUTRITION_API_BASE_URL=https://nutrition-api.example.com
VITE_COACH_API_BASE_URL=https://coach-api.example.com

# Only used by the local development build. Production always uses the live API.
VITE_FORCE_LIVE_API=true
